# BookBridge Django Environment Configuration

DEBUG=True
SECRET_KEY=django-insecure-bookbridge-secret-key-production-change-me-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bookbridge_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis Cache & Channels
REDIS_URL=redis://localhost:6379/0

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key-here
FAISS_INDEX_PATH=./ai_data/vector_store
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
